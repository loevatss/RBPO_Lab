  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Автоматически добавляет CSRF токен для POST/PUT/DELETE запросов",
          "const method = pm.request.method.toUpperCase();",
          "const needsCsrf = ['POST', 'PUT', 'DELETE', 'PATCH'].includes(method);",
          "",
          "if (needsCsrf) {",
          "  const token = pm.environment.get('csrf_token') || pm.collectionVariables.get('csrf_token');",
          "  if (token) {",
          "    pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: token });",
          "    console.log('CSRF токен добавлен:', token.substring(0, 40) + '...');",
          "  } else {",
          "    console.warn('⚠️ CSRF токен не найден! Сначала выполните запрос \"Получить CSRF токен\"');",
          "  }",
          "}"
        ]
      }
    }
  ],
