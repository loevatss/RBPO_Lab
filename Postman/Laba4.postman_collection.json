  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Lab 5: JWT. Автоматически добавляет Authorization: Bearer <access_token> для защищённых запросов.",
          "const url = pm.request.url.toString();",
          "const isAuth = url.includes('/api/auth/login') || url.includes('/api/auth/refresh') || url.includes('/api/auth/register');",
          "",
          "if (!isAuth) {",
          "  const access = pm.environment.get('access_token') || pm.collectionVariables.get('access_token');",
          "  if (access) {",
          "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + access });",
          "  } else {",
          "    console.warn('Нет access_token. Сначала выполните запрос Auth -> Логин (JWT).');",
          "  }",
          "}"
        ]
      }
    }
  ],
