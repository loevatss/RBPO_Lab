                "exec": [
                  "// Автоматически сохраняет CSRF токен из ответа",
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.token) {",
                  "    pm.environment.set('csrf_token', json.token);",
                  "    pm.collectionVariables.set('csrf_token', json.token);",
                  "    console.log('✅ CSRF токен сохранён:', json.token.substring(0, 40) + '...');",
                  "  }",
                  "}"
